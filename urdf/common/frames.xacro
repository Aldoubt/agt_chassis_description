<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="agt_base_frames">
    <link name="base_footprint"/>
    <link name="base_link">
      <collision>
        <origin xyz="${' '.join(str(v) for v in collision['origin_xyz'])}"
                rpy="${' '.join(str(v) for v in collision['origin_rpy'])}"/>
        <geometry><box size="${' '.join(str(v) for v in collision['size'])}"/></geometry>
      </collision>
    </link>
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/><child link="base_link"/>
      <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
