{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGT Robot Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "robot_id", "description", "base", "frames", "sensors", "capabilities", "geometry", "motion", "terrain"],
  "properties": {
    "schema_version": {"const": 1},
    "robot_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "description": {
      "type": "object", "required": ["xacro", "calibration"],
      "properties": {"xacro": {"type": "string"}, "calibration": {"type": "string"}}
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "driver", "kinematics", "command_interface", "odom_source",
        "publish_odom_tf", "control_rate_hz", "rotate_in_place"
      ],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "driver": {"type": "string", "minLength": 1},
        "kinematics": {"enum": ["skid_steer", "differential", "ackermann"]},
        "command_interface": {"type": "string", "minLength": 1},
        "odom_source": {"type": "string", "pattern": "^/[^ ]+$"},
        "publish_odom_tf": {"const": false},
        "control_rate_hz": {"type": "integer", "exclusiveMinimum": 0},
        "rotate_in_place": {"type": "boolean"},
        "ackermann": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wheelbase_m", "steering_angle_min_rad", "steering_angle_max_rad",
            "max_steering_rate_radps", "minimum_turning_radius_m"
          ],
          "properties": {
            "wheelbase_m": {"type": "number", "exclusiveMinimum": 0},
            "steering_angle_min_rad": {"type": "number", "exclusiveMaximum": 0},
            "steering_angle_max_rad": {"type": "number", "exclusiveMinimum": 0},
            "max_steering_rate_radps": {"type": "number", "exclusiveMinimum": 0},
            "minimum_turning_radius_m": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kinematics": {"const": "ackermann"}}, "required": ["kinematics"]},
          "then": {"required": ["ackermann"], "properties": {"rotate_in_place": {"const": false}}}
        },
        {
          "if": {"properties": {"kinematics": {"enum": ["skid_steer", "differential"]}}, "required": ["kinematics"]},
          "then": {"not": {"required": ["ackermann"]}}
        }
      ]
    },
    "frames": {
      "type": "object", "required": ["base", "footprint", "lidar", "imu"],
      "properties": {
        "base": {"type": "string"}, "footprint": {"type": "string"},
        "lidar": {"type": "string"}, "imu": {"type": "string"}
      }
    },
    "sensors": {
      "type": "object", "required": ["lidar", "imu", "gnss", "camera_gimbal"],
      "properties": {
        "lidar": {"$ref": "#/$defs/sensor"}, "imu": {"$ref": "#/$defs/sensor"},
        "gnss": {"$ref": "#/$defs/sensor"}, "camera_gimbal": {"$ref": "#/$defs/sensor"}
      }
    },
    "capabilities": {
      "type": "object", "required": ["navigation", "acquire_view", "perception", "manipulation"],
      "properties": {
        "navigation": {"type": "boolean"}, "acquire_view": {"type": "boolean"},
        "perception": {"type": "boolean"}, "manipulation": {"type": "boolean"}
      }
    },
    "geometry": {
      "type": "object", "required": ["width", "length", "footprint", "safety_margin", "source"],
      "properties": {
        "width": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "length": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "footprint": {"type": "array", "minItems": 3, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
        "safety_margin": {"type": ["number", "null"], "minimum": 0},
        "source": {"type": "string"}
      }
    },
    "motion": {
      "type": "object", "required": ["max_linear_velocity", "max_angular_velocity", "source"],
      "properties": {
        "max_linear_velocity": {"type": ["number", "null"], "minimum": 0},
        "max_angular_velocity": {"type": ["number", "null"], "minimum": 0},
        "source": {"type": "string"}
      }
    },
    "terrain": {
      "type": "object", "required": ["max_slope_deg", "max_step_height_m", "roughness_limit", "source"],
      "properties": {
        "max_slope_deg": {"type": ["number", "null"], "minimum": 0},
        "max_step_height_m": {"type": ["number", "null"], "minimum": 0},
        "roughness_limit": {"type": ["number", "null"], "minimum": 0},
        "source": {"type": "string"}
      }
    }
  },
  "$defs": {
    "sensor": {
      "type": "object", "required": ["enabled", "source"],
      "properties": {
        "enabled": {"type": "boolean"}, "topic": {"type": ["string", "null"]},
        "source": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"base": {"properties": {"kinematics": {"const": "ackermann"}}, "required": ["kinematics"]}},
        "required": ["base"]
      },
      "then": {
        "properties": {
          "geometry": {
            "properties": {
              "width": {"type": "number", "exclusiveMinimum": 0},
              "length": {"type": "number", "exclusiveMinimum": 0},
              "safety_margin": {"type": "number", "minimum": 0}
            }
          },
          "motion": {
            "properties": {
              "max_linear_velocity": {"type": "number", "exclusiveMinimum": 0},
              "max_angular_velocity": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    }
  ]
}
